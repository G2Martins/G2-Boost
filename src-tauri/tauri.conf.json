{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G2 Boost",
  "version": "0.9.1",
  "identifier": "com.grovicdata.g2boost",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "G2 Boost",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://cover.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://speed.cloudflare.com https://api.steampowered.com",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Gustavo Martins Gripaldi",
    "shortDescription": "G2 Boost",
    "longDescription": "Hardware diagnostics, Windows cleanup, disk analyzer, network tools and reversible game-performance tweaks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": [
          "pt-BR",
          "en-US"
        ]
      }
    },
    "copyright": "© 2026 Gustavo Martins Gripaldi. Todos os direitos reservados.",
    "category": "Utility"
  }
}
