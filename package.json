{
  "name": "g2-boost",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release": "tauri build && node tools/release.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src e2e *.ts && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "biome check --write src *.ts",
    "test": "bun test tests && cargo test --workspace",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "2.1.1",
    "d3-hierarchy": "3.1.2",
    "lucide-react": "1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "^2",
    "@types/d3-hierarchy": "3.1.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
